# 数据库配置
# 本地开发使用 SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./yesjob.db
# Docker 生产环境使用 MySQL:
DATABASE_URL=mysql+aiomysql://yesjob:yesjob123@mysql:3306/yesjob
MYSQL_ROOT_PASSWORD=root123
MYSQL_PASSWORD=yesjob123

# JWT 配置（生产环境请使用随机密钥: openssl rand -hex 32）
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI 模型配置（至少配置一个）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Ollama 本地模型（可选）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# 向量模型路径（用于岗位推荐，留空则禁用推荐功能）
EMBEDDING_MODEL=

# AI 功能邀请码
AI_INVITE_CODE=

# 职位数据文件
JOBS_FILE=data/jobs.jsonl
