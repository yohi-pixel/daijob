    "求职者关注度：应届生关注度高，平台冷启动流量来源",
    "岗位充足度：秋招 HC 规模，大厂全年 80%+ HC 集中释放",
    "可爬取性：有公开招聘官网/结构化接口，反爬成本可控",
    "领域差异化：大厂之外覆盖硬科技/游戏/外企/新锐，错位竞争",
    "广深性价比：base 深圳/广州的出海电子/游戏/硬科技企业，薪资性价比高，覆盖华南求职群体"
  ],
  "tiers": [
    {
      "id": 1,
      "label": "互联网大厂",
      "rationale": "HC 规模最大、求职者关注度最高，必爬"
    },
    {
      "id": 2,
      "label": "垂直互联网",
      "rationale": "细分领域头部，用户点名覆盖（B站/小红书/得物）"
    },
    {
      "id": 3,
      "label": "游戏/内容",
      "rationale": "游戏行业秋招热度高，岗位质量优"
    },
    {
      "id": 4,
      "label": "硬科技/芯片/新能源车",
      "rationale": "岗位量大、薪资竞争力强，AI/硬件人才主战场"
    },
    {
      "id": 5,
      "label": "外企/快消",
      "rationale": "8 月密集开岗，覆盖外企/快消求职群体"
